import Crypto.Poseidon
import Crypto.Bn254
import Solana.Bank
import Encoding.Hex

/-! The heavier arithmetic that programs reach through system calls, and one
more program that checks signatures before a transaction runs.

* **Poseidon** over the BN254 scalar field: the parameters are generated, not
  stored, so a single agreeing hash checks all of them. The cases are the
  ones published with the reference implementation.
* **BN254** (alt_bn128): point addition, multiplication by a scalar and the
  pairing check, on the cases Ethereum's clients test their precompiles with.
* **The secp256r1 program** (P-256, the curve of passkeys): signatures made
  by OpenSSL, in the lower of their two forms, which is the only one the
  program takes.
* **Ristretto**: the encodings RFC 9496 publishes for multiples of the base
  point, and three of the encodings it says must be refused.
* **The secp256k1 program**: instructions made with an independent
  implementation of the curve and of Keccak, then damaged in each way the
  program must notice.

(Only three pairings: the official interpreter needs a minute for each pair.) -/

def poseidon (inputs : Array String) (want : String) : String := Id.run do
  let mut raw : Array ByteArray := Array.emptyWithCapacity inputs.size
  let mut turned : Array ByteArray := Array.emptyWithCapacity inputs.size
  for s in inputs do
    let b := Hex.decode s
    raw := raw.push b
    let mut r := ByteArray.emptyWithCapacity 32
    for i in [0:b.size] do
      r := r.push b[b.size - 1 - i]!
    turned := turned.push r
  let big := Poseidon.hash raw true
  let little := Poseidon.hash turned false
  let mut back := ByteArray.emptyWithCapacity 32
  for i in [0:little.size] do
    back := back.push little[little.size - 1 - i]!
  return s!"{inputs.size} inputs: {Hex.encode big}{if Hex.encode big == want then "" else " WRONG"}{if back == big then "" else " (little-endian differs)"}"

def padded (s : String) (size : Nat) : ByteArray := Id.run do
  let mut b := Hex.decode s
  while b.size < size do
    b := b.push 0
  return b

def added (name input want : String) : String :=
  let b := padded input 128
  let got := match Bn254.g1OfBytes b 0 true, Bn254.g1OfBytes b 64 true with
    | some p, some q => Hex.encode (Bn254.g1ToBytes (Bn254.g1Add p q) true)
    | _, _ => "invalid"
  s!"add {name}: {if got == want then "agrees" else "WRONG " ++ got}"

def scaled (name input want : String) : String :=
  let b := padded input 96
  let got := match Bn254.g1OfBytes b 0 true with
    | some p => Hex.encode (Bn254.g1ToBytes (Bn254.g1Scale (Mont.ofBytes b 64 true) p) true)
    | none => "invalid"
  s!"multiply {name}: {if got == want then "agrees" else "WRONG " ++ got}"

def twist (input : String) : String :=
  match Bn254.g2OfBytes (Hex.decode input) 0 true with
  | some q => if q.infinite then "infinity" else "a point"
  | none => "refused"

def paired (name input : String) (want : Nat) : String :=
  let got := Bn254.pairingCheck (Hex.decode input) true
  s!"pairing {name}: {got}{if got == want then "" else s!" WRONG, should be {want}"}"

def converted (what : String) (op : Nat) (input want : String) : String :=
  let got := Hex.encode (Bn254.convert op (Hex.decode input))
  s!"{what}: {if got == "" then "refused" else if got.length <= 64 then got else s!"{got.length / 2} bytes"}{if got == want then "" else " WRONG"}"

def secp (what : String) (datas : Array ByteArray) (want : UInt64) : String :=
  let got := Bank.verifySecp256k1 datas 0
  s!"{what}: {if got == 0 then "accepted" else s!"refused with error {got - 1}"}{if got == want then "" else " WRONG"}"

def r1 (what : String) (datas : Array ByteArray) (want : UInt64) : String :=
  let got := Bank.verifySecp256r1 datas 0
  s!"{what}: {if got == 0 then "accepted" else s!"refused with error {got - 1}"}{if got == want then "" else " WRONG"}"

/-- The instruction with one byte changed. -/
def damaged (b : ByteArray) (at_ : Nat) : ByteArray := b.set! at_ (b[at_]! ^^^ 1)

