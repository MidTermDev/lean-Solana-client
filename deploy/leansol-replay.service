# A systemd unit for the process that executes the chain beside a leansol node.
#
#   sudo cp deploy/leansol-replay.service /etc/systemd/system/
#   sudo systemctl enable --now leansol-replay
#
# It needs a store loaded by `leansol snapshot` and a node run with
# `--state` on that store, `--spool` on the directory named here, and
# `--metrics`. It is not restarted when it exits: it exits at the first bank
# hash that differs from a block's, and starting it again would only stop at
# the same block (see `leansol replay --help`).
[Unit]
Description=lean-solana-client: executes the chain (leansol replay --live)
Documentation=https://github.com/MidTermDev/lean-Solana-client
After=leansol.service
Wants=leansol.service

[Service]
User=leansol
WorkingDirectory=/var/lib/leansol
ExecStart=/usr/local/bin/leansol replay --state /var/lib/leansol/state --blocks /var/lib/leansol/spool --live
Restart=no
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/leansol
PrivateTmp=true

[Install]
WantedBy=multi-user.target
